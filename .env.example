# URL base del backend de procesamiento (Marito-stats, Python/FastAPI).
# El servidor de Next la usa para las llamadas server-side y para proxear
# /v1/* (incluidos los assets de imagen) hacia el backend.
BACKEND_URL=http://localhost:8000

# Token compartido con el backend para las escrituras (header X-Ingest-Token).
# Sólo lo usa el servidor de Next: nunca se expone al browser. Debe coincidir
# con el INGEST_TOKEN del backend; sin él, guardar roster o crear partidos
# responde 401.
INGEST_TOKEN=

# Google OAuth para Drive Picker (seleccionar carpeta de videos).
# 1. Google Cloud Console → APIs & Services → Credentials → Create Credentials → OAuth 2.0 Client ID (Web)
# 2. Authorized JavaScript origins: http://localhost:3000, https://humbol-stats-web.onrender.com
# 3. Authorized redirect URIs: http://localhost:3000, https://humbol-stats-web.onrender.com
# 4. Habilitar APIs: Google Picker API, Google Drive API
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
