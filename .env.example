# URL base del backend de procesamiento (Marito-stats, Python/FastAPI).
# El servidor de Next la usa para las llamadas server-side y para proxear
# /v1/* (incluidos los assets de imagen) hacia el backend.
BACKEND_URL=http://localhost:8000

# Token compartido con el backend para las escrituras (header X-Ingest-Token).
# Sólo lo usa el servidor de Next: nunca se expone al browser. Debe coincidir
# con el INGEST_TOKEN del backend; sin él, guardar roster o crear partidos
# responde 401.
INGEST_TOKEN=

# Google OAuth para Drive Picker (seleccionar carpeta de videos).
# Estas credenciales identifican a la app frente a Google; NO dan acceso a
# ningún Drive. El acceso lo concede cada usuario y vive en su access token.
# 1. Google Cloud Console → APIs & Services → habilitar Google Picker API y Google Drive API
# 2. Credentials → OAuth 2.0 Client ID (Web):
#      Authorized JavaScript origins: http://localhost:3000, https://humbol-stats-web.onrender.com
# 3. Credentials → API key, restringida a Google Picker API y a esos orígenes
#    (agregar también https://docs.google.com/* como website permitido)
# 4. Google Cloud → Project number (dashboard) → NEXT_PUBLIC_GOOGLE_APP_ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=
